<?xml version="1.0" encoding="utf-8"?>
<!-- brand.css .btn: orange, hover darkens, :disabled drops to 50% opacity. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"
        android:alpha="0.5"
        android:color="@color/tcs_orange" />
    <item android:state_pressed="true" android:color="@color/tcs_orange_hover" />
    <item android:color="@color/tcs_orange" />
</selector>
