<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher background: TCS orange. Deliberately the brand colour rather than the
  Android Studio default green, so this build is instantly distinguishable on a
  tablet from the older com.example.truckcapture install sitting beside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor"
            xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0" android:color="#F8991D" />
                <item android:offset="1.0" android:color="#E08918" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
