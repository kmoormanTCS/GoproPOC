<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a lens inside a tilted orbit ring — a 360 camera.

  The tilt matters. Drawn flat, a horizontal ring around a centred dot reads as
  an eye; rotating it 22° reads as an orbit instead. The ring is also kept well
  clear of the lens (inner edge at 18.5 - 3.4 = 15.1 vs a 9.5 lens radius) so
  the gap survives at mdpi, where the whole icon is only 48px.

  Everything stays inside the adaptive-icon safe zone (a 66dp circle centred in
  the 108dp viewport, so radius 33 from 54,54). Rotated half-extents are
  30.3 horizontal and 23.5 vertical, both within that.

  Pure white on purpose: the same file is reused as the <monochrome> layer for
  Android 13+ themed icons, which the system tints itself.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The 360 sweep. -->
    <group
        android:name="orbit"
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-22">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6.8"
            android:pathData="M26,54 a28,18.5 0 1,0 56,0 a28,18.5 0 1,0 -56,0 z" />
    </group>

    <!-- The lens. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44.5,54 a9.5,9.5 0 1,0 19,0 a9.5,9.5 0 1,0 -19,0 z" />
</vector>
