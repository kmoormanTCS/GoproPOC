<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-activity host. The TCS app bar lives here so every screen in the flow
  carries the branding without repeating it; ScanFragment hides it to go
  full-bleed for the camera.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tcs_bg">

    <!-- The wordmark is grey-on-white, so the bar is white; the orange rule
         below it is the brand accent (brand.css .pagehead .oline). -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Shown on every screen except Home. A tablet in kiosk mode may
                 have no system Back affordance at all, so the flow needs its
                 own way out of Uploads, Review and manual entry. -->
            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/tcs_ink2"
                android:contentDescription="@string/action_back"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:adjustViewBounds="true"
                android:src="@drawable/tcs_logo_horizontal"
                android:contentDescription="@string/tcs_logo_desc" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/screenLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TCS.Badge"
                android:textColor="@color/tcs_muted"
                android:text="@string/home_title" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/tcs_orange" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_capture" />
</LinearLayout>
