<?xml version="1.0" encoding="utf-8"?>
<!--
  The field guide. Four numbered steps in the order a tech actually does them,
  written to answer the two questions the workflow provokes: "why does the
  camera's Wi-Fi say no internet" and "where did my photos go".
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tcs_bg"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TCS.PageTitle"
            android:text="@string/help_title" />

        <View
            android:layout_width="120dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_orange_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4sp"
            android:textAppearance="@style/TextAppearance.TCS.Body"
            android:text="@string/help_intro" />

        <!-- The four steps. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TCS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:divider="@drawable/divider_hairline"
                android:showDividers="middle">

                <include android:id="@+id/step1" layout="@layout/view_help_step" />
                <include android:id="@+id/step2" layout="@layout/view_help_step" />
                <include android:id="@+id/step3" layout="@layout/view_help_step" />
                <include android:id="@+id/step4" layout="@layout/view_help_step" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Where the files live — the question that follows "is it safe". -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TCS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TCS.CardTitle"
                    android:text="@string/help_copies_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="4sp"
                    android:textAppearance="@style/TextAppearance.TCS.Body"
                    android:textColor="@color/tcs_muted"
                    android:text="@string/help_copies_body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Troubleshooting. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TCS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            app:cardBackgroundColor="@color/tcs_orange_soft"
            app:strokeColor="@color/tcs_orange">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TCS.CardTitle"
                    android:textColor="@color/tcs_amber"
                    android:text="@string/help_footer_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="4sp"
                    android:textAppearance="@style/TextAppearance.TCS.Body"
                    android:textColor="@color/tcs_ink2"
                    android:text="@string/help_footer_body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
