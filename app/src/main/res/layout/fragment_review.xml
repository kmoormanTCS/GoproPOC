<?xml version="1.0" encoding="utf-8"?>
<!--
  Review. Informational only: the upload was already enqueued when the file hit
  disk, so there is nothing here to accept or reject — this screen exists to
  confirm what was captured and to offer the next angle in one tap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tcs_bg">

    <include
        android:id="@+id/truckBanner"
        layout="@layout/view_truck_banner" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Confirmation line: green tick, no ambiguity. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_check_circle"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/capturedHeadline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/geometr415_medium"
                    android:textSize="19sp"
                    android:textColor="@color/tcs_ink"
                    tools:text="Photo 2 captured" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TCS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- The 360 frame is equirectangular, so it renders wide and
                         flat; 2:1 is its natural ratio. -->
                    <ImageView
                        android:id="@+id/thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="2:1"
                        android:adjustViewBounds="true"
                        android:background="@drawable/bg_thumb_frame"
                        android:scaleType="centerCrop"
                        android:minHeight="140dp"
                        android:contentDescription="Captured 360 photo" />

                    <TextView
                        android:id="@+id/fileNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textAppearance="@style/TextAppearance.TCS.Mono"
                        tools:text="4f3a9c21-…_20260915_131204.JPG" />

                    <TextView
                        android:id="@+id/metaText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.TCS.Muted"
                        tools:text="4.2 MB · 13:12:04 · queued for upload" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/tcs_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_cloud_upload"
                            app:tint="@color/tcs_muted"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2sp"
                            android:textAppearance="@style/TextAppearance.TCS.Muted"
                            android:text="@string/review_uploading_note" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewQueueBtn"
                style="@style/Widget.TCS.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/queue_title" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <!-- Primary, because several angles per truck is the normal case. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/anotherBtn"
            style="@style/Widget.TCS.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_capture_another"
            app:icon="@drawable/ic_camera_360" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneBtn"
            style="@style/Widget.TCS.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_done" />
    </LinearLayout>
</LinearLayout>
