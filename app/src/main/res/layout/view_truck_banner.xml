<?xml version="1.0" encoding="utf-8"?>
<!--
  Truck context strip, shared by Capture and Review. The truck number is the one
  value that must be readable at arm's length in sunlight, so it gets the
  heaviest type on the screen against the brand's grey gradient.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_truck_banner"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TCS.Badge"
            android:textColor="#D9FFFFFF"
            android:text="Truck" />

        <TextView
            android:id="@+id/bannerTruckNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/geometr415_black"
            android:textSize="30sp"
            android:textColor="@color/white"
            tools:text="7897987" />

        <TextView
            android:id="@+id/bannerGuid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#B3FFFFFF"
            tools:text="GUID 4f3a9c21…" />
    </LinearLayout>

    <!-- Running count for this truck; hidden until the second angle. -->
    <TextView
        android:id="@+id/bannerPhotoCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_badge_note"
        android:textAppearance="@style/TextAppearance.TCS.Badge"
        android:textColor="@color/tcs_amber"
        android:visibility="gone"
        tools:text="2 photos"
        tools:visibility="visible" />
</LinearLayout>
