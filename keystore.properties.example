# Copy to keystore.properties (gitignored) and fill in.
#
# The .jks file and its password are NOT in this repo — this repo is public, and
# a signing key here would let anyone build an APK that Android accepts as a
# genuine update to this app. Get both from whoever owns the TCS signing key and
# put the .jks somewhere outside version control (keystore/ is gitignored).
#
# Without these, debug builds still work but assembleRelease produces an
# UNSIGNED APK that cannot be deployed.
storeFile=keystore/tcs-truckcapture.jks
storePassword=
keyAlias=tcs
keyPassword=
